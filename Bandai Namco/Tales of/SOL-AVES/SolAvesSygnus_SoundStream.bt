//------------------------------------------------
//--- 010 Editor v16.0.2 Binary Template
//
//      File: Bandai Namco Phoenix/SOL-AVES Engine - Sygnus Sound Stream - SoundStream File
//   Authors: Nenkai
//   Version: 
//   Purpose: 
//  Category: 
// File Mask: *.soundstream
//  ID Bytes: 53 59 47 4E
//   History: 
//------------------------------------------------

// Sound Effect files are also part of the big asset files.
// The .soundstream files are directly streamed files
// Opus files appear to always be encrypted ahead of time with AES192. 
// The keys are hardcoded into the executable.

// https://tsugi-studio.com/blog/2026/07/30/cedec-2026/
// https://cedil.cesa.or.jp/cedil_sessions/view/3298

struct
{
    struct
    {
        uint Magic <format=hex, comment="Checked">;
        uint Empty;
        uint FirstSection <format=hex, comment="STRM checked for stream files">;
    } Header <bgcolor=cPurple>;
    
    // From there, if it's a sound effect file, multiple chunks are possible
    /* 'PRMS'
     * - 'ALIS'
     * - 'GRP ' (Group?)
     * - 'ABUS' (? Bus?)
     * - 'ADEV'
     * - 'ATTN'
     * - 'EFCT' (Effect)
     * - 'DUCK' (Ducking)
     * - 'LISN'
     * - 'SPKS'
     * - 'TONE' (Tones)
     * - 'GAME'
     * - 'STAT
     * - 'CMND' (Command)
     * 'ASRC' (Asset Source?)
     * 'PLAY'
     * 'SPAS'
     * 'CMAP'
     * 'STBL' (String Table)
     * 
     * Otherwise, Stream
     */
   
    struct
    {
        uint Magic;
        uint Size;
        uint NextSize;
    } MainStreamHeader <bgcolor=cBlue>;

    struct
    {
        uint Magic <format=hex>;
        uint NextChunkOffset <format=hex>;
        uint64 Hash <comment="Seemingly not used">;
        int Size <format=hex>;
    } StreamInfo <bgcolor=cDkBlue>;
        
    if (exists(StreamInfo))
    {
        // This is always expected to be at 0x2C for stream files (hardcoded)
        // uint DataOffset = (Header.Magic == 0x4E475953 && Header.FirstSection == 0x4D525453) ? 0x2C : 0x00;
    
        // Starting from here, there are 3 possibilities
        // All determined by the parent file that references this file.
        // 1. Opus header (https://github.com/vgmstream/vgmstream/blob/master/src/meta/opus.c)
        // 2. ADPCM header (0x10)
        // 3. RIFF header (WAVE)
        // Therefore, we need some heuristics
        local uint value = ReadUInt();
        
        if (value & 0x80000000)
        {
            // Assume Nintendo Opus (Kirby Air Riders, NS2)
            struct
            {
                uint ChunkType <format=hex, comment="Normally always starts with 0x80000001, unchecked">;
                uint ChunkSize <format=hex>;
                
                ubyte Version;
                ubyte NumChannels;
                ushort BytesPerPacket <format=hex>;
                uint SampleRate;
                uint NextChunkOffset <format=hex>;
                uint Reserved[2];
                uint PreSkipSamples;
            } NintendoOpusHeader <bgcolor=cBlue>;   
            
            switch (ReadUInt())
            {
                case 0x80000004:
                   struct
                   {
                       // Number of samples = SamplesPerPacket * (BodySize / BytesPerPacket)
                       // SamplesPerPacket = 960 @ 48kHz
                       
                       uint ChunkType <format=hex>;
                       uint ChunkSize <format=hex>;
                       
                       struct
                       {
                           BigEndian();
                           uint PayloadLength <format=hex>;
                           uint Checksum <format=hex>;
                           LittleEndian();
                           
                           byte Payload[PayloadLength];
                       } NintendoOpusPacket[ChunkSize / NintendoOpusHeader.BytesPerPacket] <optimize=false, bgcolor=cBlack>;
                   } NintendoOpusDataChunk <bgcolor=cGray>;
                   break;
                   
                case 0x80000005: // Should be before 0x80000004
                   struct
                   {
                       // This chunk is 0x10C in size starting from here
                       uint ChunkType <format=hex>;
                       uint BodySize <format=hex>;
    
                   } NintendoMultiStreamInfo <bgcolor=cGray>;
                   break;
            }
            
        }
        else if (value == 0x46464952) // RIFF)
        {
            Printf("NOTE: SoundStream contains a WAV file");
        }
        else
        {
            struct
            {
                // Custom 4-bit float ADPCM?
                uint NumChannels;
                uint SampleRate;
                uint NumSamples;
                uint SamplesPerBlock;   
            } ADPCMHeader;
        }
    }
} SygnusSoundBank <open=true>;

