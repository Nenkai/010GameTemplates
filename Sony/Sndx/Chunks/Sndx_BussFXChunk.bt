#include "./Sndx_Types.bt"

typedef struct
{
    uint Empty;
    CountT Entries0x10Count;
    OffsetT Entries0x10ListOffset <comment="Not used, simply an offset to the full list of 0x10 entries for each patch">;
    CountT Entries0x14Count;
    OffsetT Entries0x14ListOffset <comment="Not used, simply an offset to the full list of 0x14 entries for each patch">;
    CountT PatchCount;
    OffsetT PatchesOffset <comment="Main entries">;
    ushort Field_0x1C;
    ushort Field_0x1E;
    byte pad[0x08];
    
    for (local int i = 0; i < PatchCount; i++)
    {
        FSeek(startof(PatchesOffset) + PatchesOffset + (i * 0x30));
        struct
        {
            int Empty;
            OffsetT NameOffset;
            int Field_0x08;
            byte StageIndex;
            byte BussCount;
            byte FXCount;
            byte Count_0x0F;
            OffsetT BussOffset;
            OffsetT FXOffset;
            
            // outputLevel=<float>,isLimiterEnable=<?>;
            OffsetT ConfigStringOffset;
            ushort BXFaderIdStart;
            ushort BXFaderIdCount;
            int UnkMilliseconds0x20;
            int UnkMilliseconds0x24;
            byte pad2[0x08];
            
            struct
            {
                // Entries0x10ListOffset points to these
                for (local int j = 0; j < BussCount; j++)
                {
                    FSeek(startof(BussOffset) + BussOffset + (j * 0x08));
                    struct
                    {
                        OffsetT NameOffset;
                        byte BussId <comment="128 max">;
                        byte BussMode <comment="0, 1 or 2">;
                        short pad;
                    } Buss <read=ReadString(startof(NameOffset) + NameOffset)>;
                }
            } BussList;
            
            struct
            {
                // Entries0x14ListOffset points to these
                for (local int j = 0; j < FXCount; j++)
                {
                    FSeek(startof(FXOffset) + FXOffset + (j * 0x20));
                    struct
                    {
                        int Field_0x00;
                        OffsetT NameOffset;
                        ushort FXRackVoiceId;
                        byte BussId;
                        byte LinkCount;
                        OffsetT ParameterStringOffset;
                        OffsetT LinksOffset;
                        byte pad[0x0C];
                        
                        FSeek(startof(ParameterStringOffset) + ParameterStringOffset);
                        string ParameterString;
                        
                        if (LinkCount)
                        {
                            FSeek(startof(LinksOffset) + LinksOffset);
                            struct
                            {
                                byte DestBussId <comment="0 = master rack">;
                                byte LinkType;
                                short GainDb;
                            } Link[LinkCount];
                        }
                    } FX <read=ReadString(startof(NameOffset) + NameOffset)>;
                }
            } FXList;

        } Patch <read=ReadString(startof(NameOffset) + NameOffset)>;
    }
} BussFXChunk;

