#include "./Sndx_Types.bt"

typedef struct
{
    uint Empty;
    CountT NumNames;
    struct
    {
        OffsetT NameOffset;
        uint NameHash <comment="Must be ordered for binary search", format=hex>;
        uint XFadeIndex;
    } FadeName[NumNames] <read=ReadString(startof(NameOffset) + NameOffset)>;
} XFadeNameChunk;